# Database
DATABASE_URL=sqlite:///./geotrace.db
# For PostgreSQL/PostGIS: postgresql://user:password@localhost:5432/geotrace

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
APP_NAME=GeoTrace GIS
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/x-msvideo
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/tiff

# AI Model (optional - for future integration)
AI_MODEL_ENDPOINT=
AI_MODEL_API_KEY=
AI_MODEL_VERSION=placeholder-v1

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173